const ATLAS := ""

static var _font: FontFile = null


static func font() -> FontFile:
	if _font != null:
		return _font
	var img := Image.new()
	img.load_png_from_buffer(Marshalls.base64_to_raw(ATLAS))
	var f := FontFile.new()
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	var sz := Vector2i(SIZE, 0)
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, DESCENT)
	f.set_texture_image(0, sz, 0, img)
	for code in GLYPHS:
		var g: Array = GLYPHS[code]
		f.set_glyph_advance(0, SIZE, code, Vector2(g[6], 0))
		f.set_glyph_offset(0, sz, code, Vector2(g[4], g[5] - ASCENT))
		f.set_glyph_size(0, sz, code, Vector2(g[2], g[3]))
		f.set_glyph_uv_rect(0, sz, code, Rect2(g[0], g[1], g[2], g[3]))
		f.set_glyph_texture_idx(0, sz, code, 0)
	_font = f
	return f
